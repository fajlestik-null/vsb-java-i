<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="scoreboardPanel" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lab.ScoreboardController"
            style="-fx-background-color: #1a1a1a;">

    <top>
        <Label styleClass="arcadeText" text="SCOREBOARD" style="-fx-font-size: 60px" textFill="WHITE" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="20.0"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <TableView fx:id="scoreTable" opacity="0.9" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="nickColumn" text="Nick Name" prefWidth="237"/>
                <TableColumn fx:id="scoreColumn" text="Score" prefWidth="236"/>
            </columns>
            <BorderPane.margin>
                <Insets top="20" bottom="20" left="50" right="50"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">
            <Button fx:id="backButton" text="BACK TO MENU" mnemonicParsing="false"
                    style="-fx-background-color: #8aa3b1; -fx-text-fill: WHITE; -fx-background-radius: 10;"
                    onAction="#onBackToMenu">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Button>
        </VBox>
    </bottom>

</BorderPane>
