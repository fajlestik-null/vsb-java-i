<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="gameOver" fx:controller="lab.GameOverController"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <VBox alignment="CENTER" spacing="25">

            <Label styleClass="arcadeText" style="-fx-font-size: 100px;" text="GAME OVER!"/>

            <Label fx:id="finalScore" styleClass="arcadeText" style="-fx-font-size: 32px;" textFill="WHITE"/>

            <TextField fx:id="nameField"
                       promptText="Enter your name"
                       maxWidth="250"
                       prefHeight="35"/>


            <Button text="EXIT" mnemonicParsing="false" style="-fx-background-color: #8aa3b1;" textAlignment="CENTER" textFill="WHITE" BorderPane.alignment="CENTER" onAction="#onBackToMenu">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>
        </VBox>
    </center>

</BorderPane>
